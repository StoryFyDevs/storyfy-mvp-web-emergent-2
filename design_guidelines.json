{
  "identity": {
    "name": "StoryFy",
    "persona": "The Sonic Weaver",
    "core_philosophy": "Precision meets Emotion. A DAW that feels like a cockpit; a Player that feels like a cinema.",
    "emotional_tone": {
      "creator": "Focus, Power, Limitless, Technical",
      "listener": "Immersive, Intimate, Cinematic, Discovery"
    }
  },
  "typography": {
    "font_family_imports": [
      "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap",
      "https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&display=swap"
    ],
    "rules": {
      "headings": {
        "marketing_listener": "Syne",
        "creator_dashboard": "Space Grotesk",
        "weight": "700/800",
        "tracking": "tracking-tight"
      },
      "body": {
        "primary": "Manrope",
        "weight": "400/500",
        "tracking": "tracking-normal"
      },
      "code_script": {
        "family": "JetBrains Mono",
        "usage": "Script Editor, Timecodes, Metadata"
      }
    }
  },
  "colors": {
    "theme_strategy": "Dark Mode Default (Creator), Toggle Available",
    "palette": {
      "base": {
        "obsidian": "#050505",
        "charcoal": "#121212",
        "slate_surface": "#1E1E22"
      },
      "brand_creator": {
        "neon_cyan": "#00F0FF",
        "electric_purple": "#7000FF",
        "signal_green": "#00FF94",
        "description": "High visibility, active states, waveforms"
      },
      "brand_listener": {
        "deep_indigo": "#1A1B4B",
        "warm_gold": "#FFD700",
        "sunset_orange": "#FF6B6B",
        "description": "Warmth, story covers, progress bars"
      },
      "utility": {
        "text_primary": "#FFFFFF",
        "text_secondary": "#A1A1AA",
        "border_subtle": "rgba(255, 255, 255, 0.1)",
        "glass_bg": "rgba(20, 20, 25, 0.7)"
      }
    },
    "gradients": {
      "hero_glow": "radial-gradient(circle at 50% 50%, rgba(112, 0, 255, 0.15) 0%, rgba(5, 5, 5, 0) 70%)",
      "active_track": "linear-gradient(90deg, rgba(0, 240, 255, 0.1) 0%, rgba(0, 240, 255, 0) 100%)"
    }
  },
  "spacing_and_layout": {
    "scale": "Tailwind Extended (p-1 to p-64)",
    "containers": {
      "marketing": "max-w-7xl mx-auto px-6 md:px-12",
      "dashboard": "w-full h-screen overflow-hidden grid grid-cols-[auto_1fr] grid-rows-[auto_1fr_auto]",
      "script_editor": "max-w-3xl mx-auto py-12 px-8 bg-[#151515] shadow-2xl min-h-screen"
    },
    "grids": {
      "bento_marketing": "grid grid-cols-1 md:grid-cols-12 gap-6",
      "dashboard_panels": "flex flex-row h-full"
    }
  },
  "components": {
    "shadcn_customization": {
      "instruction": "Heavily customize shadcn components. Remove rounded corners for a 'Tech' feel in Dashboard. Use pill shapes for Listener.",
      "radius": {
        "dashboard": "rounded-sm",
        "listener": "rounded-full"
      },
      "border": {
        "dashboard": "border border-white/10",
        "listener": "border-none"
      }
    },
    "custom_components": [
      {
        "name": "WaveformTrack",
        "description": "Canvas-based audio visualization. Neon green/cyan lines on dark bg.",
        "path": "/src/components/audio/WaveformTrack.js"
      },
      {
        "name": "ScriptBlock",
        "description": "Screenplay formatted text area (Courier/Mono). Auto-indent logic.",
        "path": "/src/components/editor/ScriptBlock.js"
      },
      {
        "name": "GlassPlayer",
        "description": "Sticky bottom player with backdrop-blur-xl and progress bar.",
        "path": "/src/components/player/GlassPlayer.js"
      }
    ]
  },
