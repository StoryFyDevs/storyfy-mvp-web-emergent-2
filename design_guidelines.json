  "universal_guidelines": {
    "accessibility": "Contrast ratios MUST meet WCAG AA. Use 'text-white' on dark backgrounds, never 'text-gray-400' for body copy.",
    "motion": {
      "micro": "button: active:scale-95 transition-transform",
      "page_load": "framer-motion: initial={{opacity:0, y:20}} animate={{opacity:1, y:0}}",
      "panels": "Resize panels must have smooth drag transition but snap to grid."
    },
    "universal_rules": [
      "No gradients on text (readability issue).",
      "No center alignment for long text blocks.",
      "Use 'data-testid' on ALL interactive elements.",
      "Dark mode is default. Light mode is secondary.",
      "Dashboard must fill 100vh. No scroll on the main window, only inside panels."
    ]
  },
  "implementation_steps": [
    "1. Setup Fonts and Tailwind Colors in tailwind.config.js",
    "2. Create Layout Shells (CreatorStudioLayout vs MarketingLayout)",
    "3. Build Atomic Components (Track, Knob, ScriptLine)",
    "4. Assemble Dashboard Pages (Script, Audio, Publish)",
    "5. Assemble Listener Pages (Home, Player)",
    "6. Polish with Framer Motion"
  ]
}